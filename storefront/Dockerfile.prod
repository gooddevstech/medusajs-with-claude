# Multi-stage production Dockerfile for Next.js Storefront
FROM node:20-alpine AS dependencies

WORKDIR /app

# Copy package files
COPY package.json yarn.lock ./

# Install production dependencies only
RUN yarn install --frozen-lockfile --production=true && \
    yarn cache clean

# Builder stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json yarn.lock ./

# Install all dependencies (including dev)
RUN yarn install --frozen-lockfile && \
    yarn cache clean

# Copy source code
COPY . .

# Build Next.js application
RUN yarn build

# Production stage
FROM node:20-alpine AS runtime

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init curl

# Copy production dependencies from dependencies stage
COPY --from=dependencies /app/node_modules ./node_modules

# Copy package files
COPY --from=builder /app/package.json /app/yarn.lock ./

# Copy next config and essential files
COPY --from=builder /app/next.config.js ./
COPY --from=builder /app/tsconfig.json ./
COPY --from=builder /app/public ./public

# Copy built Next.js application (.next folder and standalone if set)
COPY --from=builder /app/.next ./.next

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Use dumb-init to handle signals
ENTRYPOINT ["dumb-init", "--"]

# Start Next.js in production mode
CMD ["yarn", "start"]

# Expose port
EXPOSE 8000

# Environment defaults
ENV NODE_ENV=production \
    PORT=8000 \
    NEXT_PUBLIC_BASE_URL=https://tindaph.app \
    NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.tindaph.app