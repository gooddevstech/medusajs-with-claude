STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-v2

# Required by @medusajs/test-utils — creates the test DB via pg-god using these
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# PayRex — test credentials must match constants in integration-tests/http/payrex-webhook.spec.ts
# medusaIntegrationTestRunner env overrides run AFTER medusa-config.ts is evaluated,
# so the actual values must live here.
PAYREX_SECRET_KEY=sk_test_e2e_fake_key
PAYREX_WEBHOOK_SECRET=whsec_test_e2e_secret
