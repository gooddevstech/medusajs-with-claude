# AWS Configuration
aws_region  = "ap-southeast-1"
aws_account_id = "905418233489"

# Project Configuration
project_name = "tindaph"
environment  = "production"

# VPC Configuration
vpc_cidr        = "10.0.0.0/16"
public_subnets = ["10.0.1.0/24", "10.0.2.0/24"]

# Aurora Serverless v2 PostgreSQL Configuration
db_name     = "medusa"
db_username = "medusa_user"
db_password = "CHANGE_ME_TO_STRONG_PASSWORD"

aurora_min_capacity = 0.5
aurora_max_capacity = 4.0

# ElastiCache Serverless Valkey Configuration
valkey_max_storage_gb        = 5
valkey_max_ecpu_per_second   = 1000

# ECS Backend Configuration
backend_cpu           = 512
backend_memory        = 1024
backend_desired_count = 2
backend_max_capacity  = 4

# ECS Storefront Configuration
storefront_cpu           = 512
storefront_memory        = 1024
storefront_desired_count = 2
storefront_max_capacity  = 4

# Domain Configuration
domain_name = "tindaph.app"
create_certificate = true

# Tags
tags = {
  Project     = "tindaph"
  Environment = "production"
  ManagedBy   = "Terraform"
}