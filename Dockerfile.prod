# Multi-stage production Dockerfile for Medusa Backend (Lambda Web Adapter)
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files including yarn berry config
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn

# Install all dependencies
RUN yarn install --immutable && \
    yarn cache clean

# Copy source code
COPY . .

# Build Medusa admin and backend
RUN yarn build && \
    yarn medusa build

# Production stage
FROM node:20-alpine AS runtime

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init curl

# Copy Lambda Web Adapter — translates Lambda invocation events into HTTP requests
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.8.4 /lambda-adapter /opt/extensions/lambda-adapter

# Copy package files and yarn berry config
COPY --from=builder /app/package.json /app/yarn.lock /app/.yarnrc.yml ./
COPY --from=builder /app/.yarn ./.yarn
COPY --from=builder /app/node_modules ./node_modules

# Copy built code, admin panel, and source (needed for module resolution at runtime)
COPY --from=builder /app/.medusa ./.medusa
COPY --from=builder /app/src ./src

# Admin panel served from /app/public/admin (Medusa looks here at runtime)
COPY --from=builder /app/.medusa/server/public/admin ./public/admin

# Copy essential config files
COPY --from=builder /app/medusa-config.ts ./
COPY --from=builder /app/tsconfig.json ./

# Pre-create migrations directories for modules that have none.
# Medusa's migration runner does mkdir on these paths; Lambda's image
# filesystem is read-only at runtime, so the mkdir fails and the whole
# migration exits with error, leaving link tables (e.g. region_payment_provider)
# uncreated. Creating them here at build time avoids that.
RUN mkdir -p \
    src/modules/payrex/migrations \
    node_modules/@medusajs/auth-emailpass/dist/migrations \
    node_modules/@medusajs/fulfillment-manual/dist/migrations \
    node_modules/@medusajs/notification-local/dist/migrations \
    node_modules/@medusajs/cache-inmemory/dist/migrations \
    node_modules/@medusajs/event-bus-local/dist/migrations \
    node_modules/@medusajs/locking/dist/migrations \
    node_modules/@medusajs/file/dist/migrations \
    node_modules/@medusajs/event-bus-redis/dist/migrations \
    node_modules/@medusajs/cache-redis/dist/migrations

# Use dumb-init to handle signals
ENTRYPOINT ["dumb-init", "--"]

# Start Medusa — Lambda Web Adapter intercepts Lambda events and proxies to port 9000
CMD ["yarn", "medusa", "start"]

# Expose port
EXPOSE 9000

# Environment defaults
ENV NODE_ENV=production \
    PORT=9000 \
    AWS_LWA_PORT=9000 \
    AWS_LWA_READINESS_CHECK_PATH=/health
